# bugprone-easily-swappable-parameters is disabled: nearly every emulator function takes
# several integers (register numbers, addresses, values), so it reports almost everything and
# trains contributors to ignore diagnostics (DEVELOPMENT "Static analysis").
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-duplicate-include
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include/ultraviolent|src)/.*'