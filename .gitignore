# Build trees
/build/
/cmake-build-*/

# Private/proprietary/local assets and runtime state
/local/
/run/
/state/

# Editor/OS noise
.DS_Store
*.swp
*.swo
*~

# Generated docs
*.html

# Profiling/debug outputs
perf.data
perf.data.old
/core
/core.[0-9]*

# Python bytecode
__pycache__/
# User-supplied proprietary assets and manuals (CLEANROOM.adoc). Only the asset README is
# tracked; firmware, media, disks, and PDF manuals never enter Git.
/assets/*
!/assets/README.adoc
/doc/*.pdf
